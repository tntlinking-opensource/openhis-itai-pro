{
  "name": "@zxplat/common-ui",
  "version": "5.5.9",
  "homepage": "https://github.com/vbenjs/vue-vben-admin",
  "bugs": "https://github.com/vbenjs/vue-vben-admin/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vbenjs/vue-vben-admin.git",
    "directory": "packages/effects/common-ui"
  },
  "license": "LGPL-3.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./es/tippy": {
      "types": "./src/components/tippy/index.ts",
      "default": "./src/components/tippy/index.ts"
    },
    "./es/loading": {
      "types": "./src/components/loading/index.ts",
      "default": "./src/components/loading/index.ts"
    },
    "./es/authentication": {
      "types": "./src/ui/authentication/index.ts",
      "default": "./src/ui/authentication/index.ts"
    }
  },
  "dependencies": {
    "@zxplat-core/form-ui": "workspace:*",
    "@zxplat-core/popup-ui": "workspace:*",
    "@zxplat-core/preferences": "workspace:*",
    "@zxplat-core/shadcn-ui": "workspace:*",
    "@zxplat-core/shared": "workspace:*",
    "@zxplat-core/table-layout-ui": "workspace:*",
    "@zxplat/constants": "workspace:*",
    "@zxplat/hooks": "workspace:*",
    "@zxplat/icons": "workspace:*",
    "@zxplat/locales": "workspace:*",
    "@zxplat/types": "workspace:*",
    "@vueuse/core": "catalog:",
    "@vueuse/integrations": "catalog:",
    "element-plus": "catalog:",
    "json-bigint": "catalog:",
    "qrcode": "catalog:",
    "tippy.js": "catalog:",
    "vue": "catalog:",
    "vue-json-viewer": "catalog:",
    "vue-router": "catalog:",
    "vue-tippy": "catalog:",
    "vxe-table": "catalog:"
  },
  "devDependencies": {
    "@types/qrcode": "catalog:"
  }
}
