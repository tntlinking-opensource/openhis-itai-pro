      "types": "./src/authentication/index.ts",
      "default": "./src/authentication/index.ts"
    }
  },
  "dependencies": {
    "@zxplat-core/composables": "workspace:*",
    "@zxplat-core/form-ui": "workspace:*",
    "@zxplat-core/layout-ui": "workspace:*",
    "@zxplat-core/menu-ui": "workspace:*",
    "@zxplat-core/popup-ui": "workspace:*",
    "@zxplat-core/shadcn-ui": "workspace:*",
    "@zxplat-core/shared": "workspace:*",
    "@zxplat-core/tabs-ui": "workspace:*",
    "@zxplat/constants": "workspace:*",
    "@zxplat/hooks": "workspace:*",
    "@zxplat/icons": "workspace:*",
    "@zxplat/locales": "workspace:*",
    "@zxplat/preferences": "workspace:*",
    "@zxplat/stores": "workspace:*",
    "@zxplat/types": "workspace:*",
    "@zxplat/utils": "workspace:*",
    "@vueuse/core": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:"
  }
}
