# 朝阳中医院 H22010402403 — 生产环境院点差异
# 构建：OPENHIS_PROJECT=H22010402403 pnpm run build:project

VITE_OPENHIS_PROJECT=H22010402403

# 医保电子凭证（FunctionId=3 ec.query，经 OpenHIS.Win 调 NationECCode.dll）
