{
  "name": "zxplat-ui",
  "version": "5.5.9",
  "private": true,
  "keywords": [
    "monorepo",
    "turbo",
    "zxplat",
    "vue",
    "vue3",
    "element-plus"
  ],
  "homepage": "https://github.com/vbenjs/vue-vben-admin",
  "bugs": "https://github.com/vbenjs/vue-vben-admin/issues",
  "repository": "vbenjs/vue-vben-admin.git",
  "license": "LGPL-3.0",
  "author": {
    "name": "vben",
    "email": "ann.vben@gmail.com",
    "url": "https://github.com/anncwb"
  },
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 turbo build",
    "build:analyze": "turbo build:analyze",
    "build:docker": "./scripts/deploy/build-local-docker-image.sh",
    "build:ele": "pnpm run build --filter=@zxplat/web-ele",
    "build:ele:红旗医院H22010402403": "pnpm -F @zxplat/web-ele run build:红旗医院H22010402403",
    "build:ele:国基医院H22010202493": "pnpm -F @zxplat/web-ele run build:国基医院H22010202493",
    "build:ele:东北师大医院H22010200596": "pnpm -F @zxplat/web-ele run build:东北师大医院H22010200596",
    "changeset": "pnpm exec changeset",
    "check": "pnpm run check:circular && pnpm run check:dep && pnpm run check:type && pnpm check:cspell",
    "check:circular": "vsh check-circular",
    "check:cspell": "cspell lint **/*.ts **/README.md .changeset/*.md --no-progress",
    "check:dep": "vsh check-dep",
    "check:type": "turbo run typecheck",
    "clean": "node ./scripts/clean.mjs",
    "commit": "czg",
    "dev": "turbo-run dev",
    "dev:ele": "pnpm -F @zxplat/web-ele run dev",
    "dev:ele:红旗医院H22010402403": "pnpm -F @zxplat/web-ele run dev:红旗医院H22010402403",
    "dev:ele:国基医院H22010202493": "pnpm -F @zxplat/web-ele run dev:国基医院H22010202493",
    "dev:ele:东北师大医院H22010200596": "pnpm -F @zxplat/web-ele run dev:东北师大医院H22010200596",
    "format": "vsh lint --format",
    "lint": "vsh lint",
    "postinstall": "pnpm -r run stub --if-present",
    "preinstall": "npx only-allow pnpm",
    "preview": "turbo-run preview",
    "publint": "vsh publint",
    "reinstall": "pnpm clean --del-lock && pnpm install",
    "test:unit": "vitest run --dom",
    "test:e2e": "turbo run test:e2e",
    "update:deps": "npx taze -r -w",
    "version": "pnpm exec changeset version && pnpm install --no-frozen-lockfile",
    "catalog": "pnpx codemod pnpm/catalog",
    "build:antd": "pnpm run build --filter=@zxplat/web-antd",
    "dev:antd": "pnpm -F @zxplat/web-antd run dev"
  },
  "dependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@vxe-ui/plugin-render-element": "^4.2.4",
    "vue-plugin-hiprint": "^0.0.60"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@zxplat/eslint-config": "workspace:*",
    "@zxplat/prettier-config": "workspace:*",
    "@zxplat/stylelint-config": "workspace:*",
    "@zxplat/tailwind-config": "workspace:*",
    "@zxplat/tsconfig": "workspace:*",
    "@zxplat/turbo-run": "workspace:*",
    "@zxplat/vite-config": "workspace:*",
    "@zxplat/vsh": "workspace:*",
    "@vitejs/plugin-vue": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "@vue/test-utils": "catalog:",
    "autoprefixer": "catalog:",
    "baseline-browser-mapping": "^2.10.42",
    "cross-env": "catalog:",
    "cspell": "catalog:",
    "happy-dom": "catalog:",
    "is-ci": "catalog:",
    "lefthook": "catalog:",
    "lint-staged": "^16.2.7",
    "playwright": "catalog:",
    "prettier": "catalog:",
    "prettier-linter-helpers": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "rimraf": "catalog:",
    "tailwindcss": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "unbuild": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "engines": {
    "node": ">=20.12.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.22.0",
  "pnpm": {
    "neverBuiltDependencies": [
      "canvas",
      "node-gyp"
    ],
    "overrides": {
      "@ast-grep/napi": "catalog:",
      "@ctrl/tinycolor": "catalog:",
      "baseline-browser-mapping": "^2.10.42",
      "caniuse-lite": "1.0.30001803",
      "clsx": "catalog:",
      "esbuild": "0.25.3",
      "jiti": "catalog:",
      "pinia": "catalog:",
      "vue": "catalog:"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint": "*"
      }
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write"
    ],
    "*.vue": [
      "prettier --write"
    ],
    "*.{json,md,html,css,scss,less}": [
      "prettier --write"
    ]
  }
}
