# 复制为 .env / .env.development 后按本机修改。勿提交真实密钥。

VITE_PORT=5777
VITE_BASE=/
VITE_GLOB_API_URL=/api

# 可选：本地读卡 / 打印 / 电子凭证（占位）
# VITE_GLOB_YB_PLUGIN_URL=http://127.0.0.1:5000/api/data/
# VITE_GLOB_HIPRINT_URL=http://127.0.0.1:17521
# VITE_GLOB_YB_EC_VOUCHER_URL=
# VITE_GLOB_YB_EC_ORG_ID=

VITE_NITRO_MOCK=false
VITE_DEVTOOLS=false
VITE_INJECT_APP_LOADING=true

# 本地安全存储密钥（务必替换）
VITE_APP_STORE_SECURE_KEY=please-replace-me-with-your-own-key
