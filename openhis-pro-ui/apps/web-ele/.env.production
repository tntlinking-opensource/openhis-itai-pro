VITE_BASE=/

# 接口地址
VITE_GLOB_API_URL=/api

# 医保读卡本地插件（OpenHIS.Win），默认 http://127.0.0.1:5000/api/data/
# VITE_GLOB_YB_PLUGIN_URL=http://127.0.0.1:5000/api/data/

# 医保电子凭证（FunctionId=3 ec.query，经 OpenHIS.Win 调 NationECCode.dll）
# cfc.jlhs.gov.cn 内网 IP 为 10.47.0.67:8089（朝阳中医院，WiFi+医保专网路由可达，无需 hosts）
# 与 chs-contract.properties 中 ec_voucher_url、fixmedins_code 保持一致
VITE_GLOB_YB_EC_VOUCHER_URL=http://10.47.0.67:8089/localcfc/api/hsecfc/localQrCodeQuery
VITE_GLOB_YB_EC_ORG_ID=H22010402403

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=gzip

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true
