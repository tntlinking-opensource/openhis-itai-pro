VITE_BASE=/

# 接口地址
VITE_GLOB_API_URL=/api

# OpenHIS.Win 安装包下载地址（默认 /downloads/OpenHis.Win.exe，对应 C:/OpenHis.Win/OpenHis.Win.exe）
# VITE_GLOB_OPENHIS_WIN_DOWNLOAD_URL=/downloads/OpenHis.Win.exe

# 医保读卡本地插件（OpenHIS.Win），默认 http://127.0.0.1:5000/api/data/
# VITE_GLOB_YB_PLUGIN_URL=http://127.0.0.1:5000/api/data/

# 医保电子凭证（院点差异见 openhis-pro-ui/projects/project-{定点码}/.env.production）
# 构建院点包：OPENHIS_PROJECT=H22010402403 pnpm run build:ele:project

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=gzip

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true
