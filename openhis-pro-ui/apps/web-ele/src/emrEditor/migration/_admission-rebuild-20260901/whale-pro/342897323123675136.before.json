否认糖尿病病史，否认脑出血等其他疾病病史。否认肝炎、结核、伤寒等传染病史。否认外伤史；否认输血史。否认药物过敏史，否认食物过敏史。","required":false,"requiredMessage":""}}]},{"type":"paragraph","attrs":{"lineHeight":null,"name":"personalHistory","textIndent":null,"paragraphMarginTop":null,"paragraphMarginBottom":null,"textAlign":"left"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"个人史："},{"type":"emrFreeText","attrs":{"slotId":"f-doc-6-1","label":"个人史","placeholder":"请在这里填写个人史","value":"生于吉林省长春市，居住于吉林省长春市。否认吸烟史、否认饮酒史。否认药物嗜好；否认疫区疫水接触史，否认冶游史，否认吸毒史；预防接种史不详。","required":false,"requiredMessage":""}}]},{"type":"paragraph","attrs":{"lineHeight":null,"name":"marriageChildHistory","textIndent":null,"paragraphMarginTop":null,"paragraphMarginBottom":null,"textAlign":"left"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"婚育史："},{"type":"emrFreeText","attrs":{"slotId":"f-doc-7-1","label":"婚育史","placeholder":"请在这里填写婚育史","value":"已婚。结婚年龄：27岁，配偶健康，有1子。","required":false,"requiredMessage":""}}]},{"type":"paragraph","attrs":{"lineHeight":null,"name":"menstrualHistory","textIndent":null,"paragraphMarginTop":null,"paragraphMarginBottom":null,"textAlign":"left"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"月经史："},{"type":"emrFreeText","attrs":{"slotId":"f-doc-8-1","label":"月经史","placeholder":"请在这里填写月经史","value":"56岁绝经","required":false,"requiredMessage":""}}]},{"type":"paragraph","attrs":{"lineHeight":null,"name":"familyHistory","textIndent":null,"paragraphMarginTop":null,"paragraphMarginBottom":null,"textAlign":"left"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"家族史："},{"type":"emrFreeText","attrs":{"slotId":"f-doc-9-1","label":"家族史","placeholder":"请在这里填写家族史","value":"父母已故。否认家族遗传病史及类似疾病史。","required":false,"requiredMessage":""}}]},{"type":"paragraph","attrs":{"lineHeight":null,"name":"tcmFourExams","textIndent":null,"paragraphMarginTop":null,"paragraphMarginBottom":null,"textAlign":"left"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"中医望闻问切："},{"type":"emrFreeText","attrs":{"s