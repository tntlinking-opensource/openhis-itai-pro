            "width": 362.8,
            "height": 240,
            "formatter": "function (data, options, templateData) {\n  var rows = templateData && templateData.tcmHerbRows;\n  if (typeof rows === 'string') {\n    try { rows = JSON.parse(rows); } catch (e) { rows = []; }\n  }\n  if (!Array.isArray(rows)) rows = [];\n  var cellStyle = 'display:inline-block;width:25%;box-sizing:border-box;padding:0 6px 0 0;vertical-align:top;position:relative;min-height:32px;font-size:10.5pt;line-height:32px;';\n  var noteStyle = 'position:absolute;top:1px;right:6px;font-size:9.5pt;color:#333;line-height:1;white-space:nowrap;';\n  var html = [];\n  rows.forEach(function (row) {\n    html.push('<div style=\"display:block;width:100%;margin-bottom:4px;overflow:hidden;\">');\n    for (var i = 1; i <= 4; i++) {\n      var col = row['col' + i] || '';\n      var note = row['note' + i] || '';\n      html.push('<span style=\"' + cellStyle + '\">');\n      if (col) html.push('<span>' + col + '</span>');\n      if (note) html.push('<span style=\"' + noteStyle + '\">' + note + '</span>');\n      html.push('</span>');\n    }\n    html.push('</div>');\n  });\n  var usage = templateData && templateData.tcmUsageText ? String(templateData.tcmUsageText) : '';\n  if (usage) {\n    html.push('<div style=\"text-align:right;margin-top:10px;font-size:10.5pt;line-height:16px;padding-right:4px;\">' + usage + '</div>');\n  }\n  html.push('<div style=\"margin-top:4px;height:28px;width:100%;\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"100%\" height=\"100%\" preserveAspectRatio=\"none\"><line x1=\"0\" y1=\"100%\" x2=\"100%\" y2=\"0\" stroke=\"#000\" stroke-width=\"1.5\" vector-effect=\"non-scaling-stroke\"/></svg></div>');\n  return html.join('');\n}",
            "testData": "[{\"col1\":\"茯苓 10g\",\"note1\":\"(包煎)\",\"col2\":\"白芍 10g\",\"note2\":\"(先煎)\",\"col3\":\"\",\"note3\":\"\",\"col4\":\"\",\"note4\":\"\"}]"
          },
