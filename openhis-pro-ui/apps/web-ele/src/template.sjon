{
  "engine": "Print",
  "panels": [
    {
      "name": "1",
      "index": 0,
      "width": 210,
      "height": 297,
      "paperType": "A4",
      "paperFooter": 800,
      "paperHeader": 96,
      "printElements": [
        {
          "options": {
            "top": 16,
            "left": 24,
            "field": "hospitalName",
            "width": 546,
            "height": 18,
            "fontSize": 14,
            "testData": "示例医院",
            "hideTitle": true,
            "textAlign": "center",
            "fontWeight": "bold"
          },
          "printElementType": {
            "type": "text",
            "title": "文本"
          }
        },
        {
          "options": {
            "top": 40,
            "left": 24,
            "field": "documentTitle",
            "width": 546,
            "height": 20,
            "fontSize": 16,
            "testData": "摆药单",
            "hideTitle": true,
            "textAlign": "center",
            "fontWeight": "bold"
          },
          "printElementType": {
            "type": "text",
            "title": "文本"
          }
        },
        {
          "options": {
            "top": 64,
            "left": 24,
            "width": 546,
            "height": 1.2,
            "borderWidth": 1.2
          },
          "printElementType": {
            "type": "hline",
            "title": "横线"
          }
        },
        {
          "options": {
            "top": 72,
            "left": 24,
            "field": "executeDateText",
            "title": "执行日期",
            "width": 200,
            "height": 16,
            "fontSize": 10,
            "testData": "2026-08-07"
          },
          "printElementType": {
            "type": "text",
            "title": "执行日期"
          }
        },
        {
          "options": {
            "top": 96,
            "left": 24,
            "field": "patientBlocks",
            "width": 546,
            "height": 680,
            "fontSize": 9,
            "formatter": "function(title,value,options,printData){\nfunction esc(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;');}\nfunction cell(text,align){return '<td style=\"border:1px solid #000;padding:4pt 3pt;text-align:'+(align||'center')+';word-break:break-all;vertical-align:middle;\">'+esc(text)+'</td>';}\nfunction tokens(raw){return String(raw||'').trim().split(/\\s+/).filter(Boolean);}\nfunction simplifyDose(raw){\n  var s=String(raw==null?'':raw).replace(/\\s*\\/\\s*次$/,'').trim();\n  var cut=s.indexOf('(');\n  if(cut<0){cut=s.indexOf('（');}\n  if(cut>0){\n    var head=s.slice(0,cut).trim();\n    var inner=s.slice(cut+1).replace(/[)）]\\s*$/,'').trim();\n    var h=head.match(/^(\\d+(?:\\.\\d+)?)(.*)$/);\n    var n=inner.match(/^(\\d+(?:\\.\\d+)?)(.*)$/);\n    if(h&&n&&String(h[2]).trim()===String(n[2]).trim()&&Number(h[1])===Number(n[1])){return String(Number(h[1]))+String(h[2]).trim();}\n  }\n  return s;\n}\nfunction isTcm(d){\n  if(!d){return false;}\n  if(d.tcmFlag===true||d.tcmFlag==='true'){return true;}\n  if(Array.isArray(d.herbs)&&d.herbs.length>=1){return true;}\n  return tokens(d.drugName).length>=2&&tokens(d.doseText).length>=2;\n}\nfunction fuValue(d){\n  var raw=d&&d.chineseHerbsDoseQuantity;\n  if(raw==null){return '';}\n  var s=String(raw).trim();\n  if(!s){return '';}\n  var n=Number(s);\n  if(!isFinite(n)||n<=0){return '';}\n  return String(n).replace(/(\\.\\d*?[1-9])0+$|\\.0+$/,'$1');\n}\nfunction pairsOf(d){\n  if(Array.isArray(d.herbs)&&d.herbs.length){\n    var ready=[];\n    for(var i=0;i<d.herbs.length;i++){\n      var item=d.herbs[i]||{};\n      ready.push({name:item.name||'',dose:simplifyDose(item.dose||'')});\n    }\n    return ready;\n  }\n  var names=tokens(d.drugName);\n  var doses=tokens(d.doseText);\n  var n=Math.max(names.length,doses.length);\n  var out=[];\n  for(var k=0;k<n;k++){out.push({name:names[k]||'',dose:simplifyDose(doses[k]||'')});}\n  return out;\n}\nfunction herbCell(h){\n  var dose=h.dose?'<span style=\"margin-left:6pt;\">'+esc(h.dose)+'</span>':'';\n  return '<td style=\"border:1px solid #000;padding:5pt 6pt;width:25%;text-align:left;vertical-align:middle;font-size:10pt;\">'+esc(h.name)+dose+'</td>';\n}\nfunction tcmCard(pairs,fu){\n  var html='<div style=\"margin:0 0 8pt 0;border:1px solid #000;\">';\n  var banner='中药';\n  if(fu){banner=banner+'　付数：'+esc(fu);}\n  html+='<div style=\"background:#f0f0f0;padding:3pt 6pt;font-size:9pt;font-weight:bold;\">'+banner+'</div>';\n  html+='<table style=\"width:100%;border-collapse:collapse;table-layout:fixed;\">';\n  var list=pairs.length?pairs:[{name:'',dose:''}];\n  for(var i=0;i<list.length;i+=4){\n    html+='<tr>';\n    for(var c=0;c<4;c++){\n      var h=list[i+c];\n      html+=h?herbCell(h):'<td style=\"border:1px solid #000;padding:5pt 6pt;width:25%;\"></td>';\n    }\n    html+='</tr>';\n  }\n  html+='</table></div>';\n  return html;\n}\nvar blocks=Array.isArray(value)?value:((printData&&printData.patientBlocks)||[]);\nvar html='';\nfor(var i=0;i<blocks.length;i++){\n  var b=blocks[i]||{};\n  var head=esc(b.patientHeadText||'');\n  var drugs=Array.isArray(b.drugRows)?b.drugRows:[];\n  var west=[];\n  var tcm=[];\n  for(var j=0;j<drugs.length;j++){\n    var d=drugs[j]||{};\n    if(isTcm(d)){tcm.push(d);}else{west.push(d);}\n  }\n  html+='<div style=\"margin:0 0 14pt 0;\">';\n  html+='<div style=\"font-size:10pt;font-weight:bold;line-height:1.5;padding:2pt 0 6pt 0;\">'+head+'</div>';\n  for(var t=0;t<tcm.length;t++){html+=tcmCard(pairsOf(tcm[t]),fuValue(tcm[t]));}\n  if(west.length){\n    html+='<table style=\"width:100%;border-collapse:collapse;font-size:9pt;table-layout:fixed;\">';\n    html+='<thead><tr>';\n    html+='<th style=\"border:1px solid #000;background:#f0f0f0;padding:4pt 3pt;width:36%;text-align:left;\">药品名称</th>';\n    html+='<th style=\"border:1px solid #000;background:#f0f0f0;padding:4pt 3pt;width:28%;text-align:left;\">规格</th>';\n    html+='<th style=\"border:1px solid #000;background:#f0f0f0;padding:4pt 3pt;width:18%;text-align:center;\">剂量</th>';\n    html+='<th style=\"border:1px solid #000;background:#f0f0f0;padding:4pt 3pt;width:18%;text-align:center;\">总量</th>';\n    html+='</tr></thead><tbody>';\n    for(var w=0;w<west.length;w++){\n      var row=west[w]||{};\n      html+='<tr>';\n      html+=cell(row.drugName,'left');\n      html+=cell(row.specText,'left');\n      html+=cell(row.doseText,'center');\n      html+=cell(row.totalQuantityText,'center');\n      html+='</tr>';\n    }\n    html+='</tbody></table>';\n  }\n  html+='</div>';\n}\nreturn html;\n}",
            "hideTitle": true,
            "lineHeight": 12,
            "leftSpaceRemoved": false
          },
          "printElementType": {
            "type": "longText",
            "title": "摆药明细"
          }
        }
      ],
      "watermarkOptions": {
        "width": 200,
        "format": "YYYY-MM-DD HH:mm",
        "height": 200,
