# 端口号
VITE_PORT=5777

VITE_BASE=/

# 接口地址
VITE_GLOB_API_URL=/api

# 医保读卡本地插件（OpenHIS.Win），默认 http://127.0.0.1:5000/api/data/
# VITE_GLOB_YB_PLUGIN_URL=http://127.0.0.1:5000/api/data/

# 是否开启 Nitro Mock服务，true 为开启，false 为关闭
VITE_NITRO_MOCK=false

# 门诊挂号：true 走前端内存 mock；false 走真实 HTTP（路径 /api/op/register/...）
VITE_USE_MOCK_OP_REGISTER=true

# 药库订货单：true 走前端内存 mock；false 走真实 HTTP（/pharmacy-warehouse/purchase-order/...）
VITE_USE_MOCK_PURCHASE_REQUEST=true

# 药库调拨单：true 走前端内存 mock；false 走真实 HTTP（当前接口暂复用 /pharmacy-warehouse/purchase-order/...）
VITE_USE_MOCK_TRANSFER_ORDER=true

# 药库退货入库：true 走前端内存 mock；false 走真实 HTTP（复用 /pharmacy-warehouse/purchase-order/...）
VITE_USE_MOCK_RETURN_INBOUND=true

# 药库采购退货：true 走前端内存 mock；false 走真实 HTTP（/pharmacy-warehouse/return-order/...、stockIn-order/...）
VITE_USE_MOCK_PURCHASE_RETURN=true

# 药库损益单：true 走前端内存 mock；false 走真实 HTTP（/pharmacy-warehouse/profitLoss-order/...）；订货导入弹窗在 mock 下复用订货单 mock 数据
VITE_USE_MOCK_GAIN_LOSS=true

# 药库采购入库（列表/工作站）：true 走前端内存 mock（init/page/detail/增删改/审批）；开启后 getWarehouseByType 亦走本 mock 仓表，与其它库房模块 mock 同开时请自行核对下拉数据是否够用
VITE_USE_MOCK_WAREHOUSE_PURCHASE=true

# 单据审批：true 走前端内存 mock；false 走真实 HTTP（/pharmacy-warehouse/documentManagement/...）
VITE_USE_MOCK_DOCUMENT_MANAGEMENT=true

# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=false

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true
