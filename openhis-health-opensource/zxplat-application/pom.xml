<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.zxplat</groupId>
        <artifactId>zxplat</artifactId>
        <version>2.0.9</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>zxplat-application</artifactId>
    <packaging>jar</packaging>

    <name>ZXPlat Application</name>
    <description>
        应用层用例编排（原 health-application）。根级模块，不进 zxplat-core。
    </description>

    <dependencies>
        <dependency>
            <groupId>com.zxplat</groupId>
            <artifactId>zxplat-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zxplat</groupId>
            <artifactId>zxplat-infrastructure</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zxplat</groupId>
            <artifactId>zxplat-framework</artifactId>
        </dependency>
        <!-- PacsOrderIngressPort（真实现在 module-pacs-application；NoOp 在 integration.pacs） -->
        <dependency>
            <groupId>com.zxplat</groupId>
            <artifactId>module-pacs-domain</artifactId>
        </dependency>
        <!-- PEIS FIN Port（domain.port.His*）；Adapter 在 application.integration.peis -->
        <dependency>
            <groupId>com.zxplat</groupId>
            <artifactId>module-peis-domain</artifactId>
        </dependency>

        <dependency>
            <groupId>com.github.librepdf</groupId>
            <artifactId>openpdf</artifactId>
            <version>1.3.30</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.3.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>ban-plugin-bridge-from-application</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <message>
                                        zxplat-application 不得依赖插件 bridge / 扩展 Module contracts；
                                        请改用 domain.infrastructure.integration Extension SPI
                                    </message>
                                    <excludes>
                                        <exclude>com.zxplat:module-*-bridge</exclude>
                                        <exclude>com.zxplat:module-chs-jilin-*</exclude>
                                        <exclude>com.zxplat:module-bpc-*</exclude>
                                        <exclude>com.zxplat:module-wi-jilin-*</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
