<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    
    <parent>
        <groupId>com.openhis</groupId>
        <artifactId>whale-health</artifactId>
        <version>2.0.8</version>
    </parent>
    
    <artifactId>health-app</artifactId>
    <packaging>jar</packaging>
    
    <name>Health App</name>
    <description>健康应用启动模块</description>
    
    <dependencies>
        <!-- 运行时聚合（plain jar）；扩展模块仍由下方 Profile 挂载 -->
        <dependency>
            <groupId>com.openhis</groupId>
            <artifactId>health-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <profiles>
        <!-- health-app 默认挂载 EMR + Booking + Campus；院点需其他扩展时用 -Pwith-chs 等追加 -->
        <profile>
            <id>with-emr</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>com.openhis</groupId>
                    <artifactId>module-emr-starter</artifactId>
                </dependency>
                <dependency>
                    <groupId>com.openhis</groupId>
                    <artifactId>module-emr-domain</artifactId>
                    <version>${project.version}</version>
                </dependency>
                <dependency>
                    <groupId>com.openhis</groupId>
                    <artifactId>module-emr-bridge</artifactId>
                    <version>${project.version}</version>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>with-chs</id>
            <dependencies>
                <dependency>
                    <groupId>com.openhis</groupId>
                    <artifactId>module-chs-jilin-starter</artifactId>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>with-chs-remote</id>
            <dependencies>
                <dependency>
                    <groupId>com.openhis</groupId>
                    <artifactId>module-chs-jilin-host</artifactId>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>with-elep</id>
            <dependencies>
                <dependency>
                    <groupId>com.openhis</groupId>
                    <artifactId>module-elep-jilin-starter</artifactId>
                </dependency>
                <!-- 显式引入 module-elep-jilin-domain (v3 merged contracts)，确保 IDE classpath 含 ElepUploadCommand 等 DTO -->
                <dependency>
                    <groupId>com.openhis</groupId>
                    <artifactId>module-elep-jilin-domain</artifactId>
                    <version>${project.version}</version>
                </dependency>
                <dependency>
                    <groupId>com.openhis</groupId>
                    <artifactId>health-infrastructure</artifactId>
                    <version>${project.version}</version>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>with-booking</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>com.openhis</groupId>
                    <artifactId>module-booking-starter</artifactId>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>with-einvoice-boss</id>
            <dependencies>
                <dependency>
                    <groupId>com.openhis</groupId>
                    <artifactId>module-einv-boss-starter</artifactId>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>with-unionpay-bpc</id>
            <dependencies>
                <dependency>
                    <groupId>com.openhis</groupId>
                    <artifactId>module-bpc-starter</artifactId>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>with-campus</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>com.openhis</groupId>
                    <artifactId>module-campus-starter</artifactId>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>with-miniapp</id>
            <dependencies>
                <dependency>
                    <groupId>com.openhis</groupId>
                    <artifactId>module-miniapp-starter</artifactId>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>with-work-injury</id>
            <dependencies>
                <dependency>
                    <groupId>com.openhis</groupId>
                    <artifactId>module-wi-jilin-starter</artifactId>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>with-elep-remote</id>
            <dependencies>
                <dependency>
                    <groupId>com.openhis</groupId>
                    <artifactId>module-elep-jilin-host</artifactId>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
    
    <build>
        <!-- 打包时把 application.yml 的 @project.version@ 替换为 POM 版本（仅 @ 定界，不动 ${...}） -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <configuration>
                    <delimiters>
                        <delimiter>@</delimiter>
                    </delimiters>
                    <useDefaultDelimiters>false</useDefaultDelimiters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- 启动类仅在 health-app 模块；显式写出避免多模块工程下自动探测落空 -->
                    <mainClass>com.openhis.health.HealthApplication</mainClass>
                </configuration>
            </plugin>
            <!-- Flyway Maven 插件，用于修复校验和 -->
            <plugin>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-maven-plugin</artifactId>
                <configuration>
                    <url>jdbc:postgresql://localhost:5432/whale_health_db</url>
                    <user>${DB_USERNAME:postgres}</user>
                    <password>${DB_PASSWORD:root}</password>
                    <locations>
                        <location>classpath:db/migration/health</location>
                    </locations>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>

