<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.openhis</groupId>
        <artifactId>whale-health</artifactId>
        <version>2.0.3-SNAPSHOT</version>
    </parent>

    <artifactId>health-starter</artifactId>
    <packaging>jar</packaging>

    <name>Health Starter</name>
    <description>HIS 运行时聚合（plain jar）：院点与 health-app 共用，勿依赖 health-app fat jar</description>

    <dependencies>
        <dependency>
            <groupId>com.openhis</groupId>
            <artifactId>health-application</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.openhis</groupId>
            <artifactId>health-infrastructure</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 工伤 domain 端口/DTO：health-application 编译引用，运行时须可加载（实现由 with-work-injury starter 装配） -->
        <dependency>
            <groupId>com.openhis</groupId>
            <artifactId>module-wi-jilin-domain</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.openhis</groupId>
            <artifactId>whale-core</artifactId>
            <version>${whale.framework.version}</version>
        </dependency>

        <dependency>
            <groupId>com.openhis</groupId>
            <artifactId>whale-identity</artifactId>
            <version>${whale.framework.version}</version>
        </dependency>

        <dependency>
            <groupId>com.openhis</groupId>
            <artifactId>whale-audit</artifactId>
            <version>${whale.framework.version}</version>
        </dependency>

        <dependency>
            <groupId>com.openhis</groupId>
            <artifactId>whale-runtime</artifactId>
            <version>${whale.framework.version}</version>
        </dependency>

        <dependency>
            <groupId>com.openhis</groupId>
            <artifactId>whale-web</artifactId>
            <version>${whale.framework.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>

        <dependency>
            <groupId>com.alibaba.fastjson2</groupId>
            <artifactId>fastjson2</artifactId>
            <version>2.0.58</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
