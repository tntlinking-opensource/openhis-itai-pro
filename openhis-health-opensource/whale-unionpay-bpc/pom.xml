<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0          http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.openhis</groupId>
    <artifactId>whale</artifactId>
    <version>2.0.2-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>whale-unionpay-bpc</artifactId>
  <packaging>pom</packaging>
  <name>Whale UnionPay BPC</name>
  <description>Whale 银联 BPC 被扫收单扩展包</description>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.openhis</groupId>
        <artifactId>whale-core</artifactId>
        <version>${whale.framework.version}</version>
      </dependency>
      <dependency>
        <groupId>com.openhis</groupId>
        <artifactId>health-domain-shared</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.openhis</groupId>
        <artifactId>health-domain</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.openhis</groupId>
        <artifactId>health-module-support</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.openhis</groupId>
        <artifactId>unionpay-bpc-contracts</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.openhis</groupId>
        <artifactId>unionpay-bpc-domain</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.openhis</groupId>
        <artifactId>unionpay-bpc-adapter</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.openhis</groupId>
        <artifactId>unionpay-bpc-application</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <modules>
    <module>unionpay-bpc-contracts</module>
    <module>unionpay-bpc-domain</module>
    <module>unionpay-bpc-adapter</module>
    <module>unionpay-bpc-application</module>
    <module>unionpay-bpc-starter</module>
  </modules>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals>
              <goal>jar-no-fork</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>