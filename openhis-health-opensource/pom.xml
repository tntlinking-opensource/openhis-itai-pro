<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.7</version>
        <relativePath/>
    </parent>

    <groupId>com.openhis</groupId>
    <artifactId>whale</artifactId>
    <version>2.0.2-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>OpenHIS All</name>
    <description>OpenHIS 项目聚合 - 统一管理 Whale 框架和 Whale Health 应用</description>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- 统一版本管理：与根 project.version 保持一致 -->
        <whale.framework.version>${project.version}</whale.framework.version>
        <whale.health.version>${project.version}</whale.health.version>
        <whale.emr.version>${project.version}</whale.emr.version>
        <whale.mrms.version>${project.version}</whale.mrms.version>
        <whale.chs.version>${project.version}</whale.chs.version>
        <whale.elep.version>${project.version}</whale.elep.version>
        <whale.report.version>${project.version}</whale.report.version>
        <whale.booking.version>${project.version}</whale.booking.version>

        <lombok.version>1.18.30</lombok.version>
        <mapstruct.version>1.5.5.Final</mapstruct.version>
        <openhis.framework.maven.repo>file://${maven.multiModuleProjectDirectory}/dist/framework-maven-repo</openhis.framework.maven.repo>
    </properties>
    <repositories>
        <repository>
            <id>openhis-framework-binary</id>
            <name>OpenHIS Framework (prebuilt binaries)</name>
            <url>${openhis.framework.maven.repo}</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>
    </repositories>
    <!-- 默认构建 BOM + framework + 全部业务 Module（health-app 扩展依赖仍由 with-* Profile 控制） -->
    <modules>
        <module>whale-dependencies</module>
        <module>whale-health</module>
        <module>whale-emr</module>
        <module>whale-mrms</module>
        <module>whale-booking</module>
        <module>whale-report</module>
        <module>whale-chs-jilin</module>
        <module>whale-elep-jilin</module>
        <module>whale-einvoice-boss</module>
        <module>whale-unionpay-bpc</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.openhis</groupId>
                <artifactId>whale-dependencies</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <profiles>
        <profile>
            <id>with-emr</id>
    <modules>
        <module>whale-dependencies</module>
        <module>whale-health</module>
        <module>whale-emr</module>
        <module>whale-mrms</module>
        <module>whale-booking</module>
        <module>whale-report</module>
        <module>whale-chs-jilin</module>
        <module>whale-elep-jilin</module>
        <module>whale-einvoice-boss</module>
        <module>whale-unionpay-bpc</module>
    </modules>
        </profile>
        <profile>
            <id>with-mrms</id>
    <modules>
        <module>whale-dependencies</module>
        <module>whale-health</module>
        <module>whale-emr</module>
        <module>whale-mrms</module>
        <module>whale-booking</module>
        <module>whale-report</module>
        <module>whale-chs-jilin</module>
        <module>whale-elep-jilin</module>
        <module>whale-einvoice-boss</module>
        <module>whale-unionpay-bpc</module>
    </modules>
        </profile>
        <profile>
            <id>with-chs</id>
    <modules>
        <module>whale-dependencies</module>
        <module>whale-health</module>
        <module>whale-emr</module>
        <module>whale-mrms</module>
        <module>whale-booking</module>
        <module>whale-report</module>
        <module>whale-chs-jilin</module>
        <module>whale-elep-jilin</module>
        <module>whale-einvoice-boss</module>
        <module>whale-unionpay-bpc</module>
    </modules>
        </profile>
        <profile>
            <id>with-elep</id>
    <modules>
        <module>whale-dependencies</module>
        <module>whale-health</module>
        <module>whale-emr</module>
        <module>whale-mrms</module>
        <module>whale-booking</module>
        <module>whale-report</module>
        <module>whale-chs-jilin</module>
        <module>whale-elep-jilin</module>
        <module>whale-einvoice-boss</module>
        <module>whale-unionpay-bpc</module>
    </modules>
        </profile>
        <profile>
            <id>with-booking</id>
        </profile>
        <profile>
            <id>with-einvoice-boss</id>
        </profile>
        <profile>
            <id>with-unionpay-bpc</id>
        </profile>
        <profile>
            <id>with-report</id>
        </profile>
<!-- 开源仓：仅 HIS 核心（无扩展模块） -->
</profiles>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                        <encoding>${project.build.sourceEncoding}</encoding>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
