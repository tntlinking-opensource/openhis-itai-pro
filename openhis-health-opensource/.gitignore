# 开源仓 .gitignore（由 export-opensource-tree.ps1 写入导出目录）
# 注意：勿添加 dist/ 或 *.jar 全局规则，dist/framework-maven-repo 须提交 Git

target/
build/
out/

.idea/
*.iml
.vscode/
.mvn/

logs/
*.log
**/application-local.yml
**/application-local.properties
**/application-local.yaml
.env

# 仅提交试用 openhis.lic；私钥与其它 secret 仍忽略
local-secrets/**
!local-secrets/license/
local-secrets/license/*
!local-secrets/license/openhis.lic

.DS_Store
Thumbs.db
Desktop.ini
