target/
build/
out/

.idea/
*.iml
.vscode/*
!.vscode/settings.json
!.vscode/launch.json

logs/
*.log
**/application-local.yml
**/application-local.properties
**/application-local.yaml
.env
local-secrets/

.DS_Store
Thumbs.db
Desktop.ini
