<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.zxplat</groupId>
        <artifactId>zxplat-module-chs-jilin</artifactId>
        <version>2.0.9</version>
    </parent>

    <artifactId>module-chs-jilin-host</artifactId>
    <packaging>jar</packaging>
    <name>CHS Jilin Host</name>
    <description>Gateway-Only Remote：HIS 侧 Remote Client + 医保网 gateway-proxy</description>

    <dependencies>
        <dependency>
            <groupId>com.zxplat</groupId>
            <artifactId>module-chs-jilin-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zxplat</groupId>
            <artifactId>module-chs-jilin-gateway</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zxplat</groupId>
            <artifactId>zxplat-framework</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <classifier>gateway-proxy</classifier>
                    <mainClass>com.zxplat.plugin.chs.host.proxy.ChsGatewayProxyApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
