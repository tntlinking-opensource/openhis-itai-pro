<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.openhis</groupId>
        <artifactId>whale</artifactId>
        <version>2.0.3-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>whale-module-einvoice-boss</artifactId>
    <packaging>pom</packaging>

    <name>Whale Module EInvoice Boss</name>
    <description>Whale 博思医疗电子票据扩展 Module（v3：无 contracts）</description>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.openhis</groupId>
                <artifactId>whale-core</artifactId>
                <version>${whale.framework.version}</version>
            </dependency>
            <dependency>
                <groupId>com.openhis</groupId>
                <artifactId>health-domain-shared</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.openhis</groupId>
                <artifactId>health-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.openhis</groupId>
                <artifactId>health-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.openhis</groupId>
                <artifactId>module-einv-boss-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.openhis</groupId>
                <artifactId>module-einv-boss-gateway</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.openhis</groupId>
                <artifactId>module-einv-boss-bridge</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.openhis</groupId>
                <artifactId>module-einv-boss-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.openhis</groupId>
                <artifactId>module-einv-boss-host</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.openhis</groupId>
                <artifactId>module-einv-boss-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <modules>
        <module>module-einv-boss-domain</module>
        <module>module-einv-boss-gateway</module>
        <module>module-einv-boss-bridge</module>
        <module>module-einv-boss-application</module>
        <module>module-einv-boss-host</module>
        <module>module-einv-boss-starter</module>
    </modules>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
