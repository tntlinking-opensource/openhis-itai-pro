<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.openhis</groupId>
        <artifactId>whale-emr</artifactId>
        <version>2.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>emr-application</artifactId>
    <packaging>jar</packaging>

    <name>EMR Application</name>
    <description>电子病历应用层（AppService、DTO、Request）</description>

    <dependencies>
        <!-- EMR Domain -->
        <dependency>
            <groupId>com.openhis</groupId>
            <artifactId>emr-domain</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- EMR Contracts（Port 契约，与 report-application 对齐） -->
        <dependency>
            <groupId>com.openhis</groupId>
            <artifactId>emr-contracts</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Whale Core -->
        <dependency>
            <groupId>com.openhis</groupId>
            <artifactId>whale-core</artifactId>
        </dependency>

        <!-- Whale Identity（如需当前用户信息） -->
        <dependency>
            <groupId>com.openhis</groupId>
            <artifactId>whale-identity</artifactId>
        </dependency>

        <!-- Spring Boot Starter (包含 validation) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- WebMvcConfigurer / 静态资源映射（EmrUploadResourceConfiguration） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!-- MapStruct -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- OpenPDF：EMR JSON → PDF 渲染 -->
        <dependency>
            <groupId>com.github.librepdf</groupId>
            <artifactId>openpdf</artifactId>
            <version>1.3.30</version>
        </dependency>
    </dependencies>
</project>

