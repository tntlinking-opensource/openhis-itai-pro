<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.openhis</groupId>
        <artifactId>whale</artifactId>
        <version>2.0.5</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>whale-module-elep-jilin</artifactId>
    <packaging>pom</packaging>

    <name>Whale Module ELEP Jilin</name>
    <description>吉林省电子处方扩展 Module（v3：无 contracts，Gateway-Only Remote）</description>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.openhis</groupId>
                <artifactId>whale-core</artifactId>
                <version>${whale.framework.version}</version>
            </dependency>
            <dependency>
                <groupId>com.openhis</groupId>
                <artifactId>health-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.openhis</groupId>
                <artifactId>health-domain-shared</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.openhis</groupId>
                <artifactId>health-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.openhis</groupId>
                <artifactId>module-elep-jilin-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.openhis</groupId>
                <artifactId>module-elep-jilin-gateway</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.openhis</groupId>
                <artifactId>module-elep-jilin-bridge</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.openhis</groupId>
                <artifactId>module-elep-jilin-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.openhis</groupId>
                <artifactId>module-elep-jilin-host</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <modules>
        <module>module-elep-jilin-domain</module>
        <module>module-elep-jilin-gateway</module>
        <module>module-elep-jilin-bridge</module>
        <module>module-elep-jilin-application</module>
        <module>module-elep-jilin-host</module>
        <module>module-elep-jilin-starter</module>
    </modules>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
